// LC 875 Koko Eating Bananas - Binary Search
//given:An array piles[] (banana piles)
//A number h (total hours)
//Koko can eat bananas at a fixed speed k bananas per hour.
//In one hour:    She chooses one pile.    She eats up to k bananas from that pile.
//If the pile has less than k, she eats all of them.   
//piles = [3, 6, 7, 11]  h = 8                                    Try speed = 4
//Hours needed:   3 → 1 hour   6 → 2 hours   7 → 2 hours   11 → 3 hours     Total = 8 hours ✅              So answer = 4

class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int lo=1;
        int hi=0;
        for(int p:piles){           // find max pile 
            hi=Math.max(hi,p);
        }
        int ans=hi;
        while(lo<=hi){
            int mid=(lo+hi)/2;
            long hr=0;
            for(int i=0;i<piles.length;i++){
               hr+=(piles[i]+mid-1)/mid;      // ceil formula 
            }
            if(hr<=h){
                ans=mid;
                hi=mid-1;
            }
            else{
                lo=mid+1;
            }
        }
        return ans;
        

        
    }
}
