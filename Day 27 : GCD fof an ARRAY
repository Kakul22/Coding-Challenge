// Given an integer array nums, return the greatest common divisor of the smallest number and largest number in nums.
The greatest common divisor of two numbers is the largest positive integer that evenly divides both numbers.
Example 1:                                                                 Explanation:    The smallest number in nums is 2. The largest number in nums is 10.
Input: nums = [2,5,6,9,10]                                                                 The greatest common divisor of 2 and 10 is 2. 
Output: 2



class Solution {
    public int findGCD(int[] nums) {
        int min=nums[0];
        int max=nums[0];
        for(int x:nums){
            if(x<min)
                min=x;
            if(x>max)
                max=x;
        }
        while(max!=0){
            int rem=min%max;
            min=max;
            max=rem;
        }
        return min;
    }
}
